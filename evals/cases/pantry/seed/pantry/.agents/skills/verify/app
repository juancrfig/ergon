#!/bin/sh
# Runs pantry in a state folder, so checks never touch the working tree and each starts from a known state.
#   app <state> <command> [arguments]   run one pantry command in .verify/<state>; a new state starts empty
#   app --reset <state>                 empty a state
#   app --help                          this text
# State folders live under .verify/ at the repo root, ignored by git. Works from any folder. The last line printed
# is the program's exit code, as "exit <n>".
here=$(cd "$(dirname "$0")/../../.." && pwd)
case "${1:-}" in
  ""|--help|-h) sed -n '2,7p' "$0" | cut -c3-; exit 0 ;;
  --reset) [ -n "${2:-}" ] || { echo "app --reset needs a state name, such as: app --reset s1" >&2; exit 2; }
           rm -rf "$here/.verify/$2"; echo "reset $2"; exit 0 ;;
esac
state=$1; shift
[ $# -gt 0 ] || { echo "app $state needs a pantry command after the state, such as: app $state stock" >&2; exit 2; }
mkdir -p "$here/.verify/$state" && cd "$here/.verify/$state" || exit 2
PYTHONPATH="$here" python3 "$here/pantry.py" "$@"
code=$?
echo "exit $code"
exit $code
