{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "One planner round: questions for the human, or the final stories",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "questions"
      ],
      "properties": {
        "questions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 7,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "question",
              "why",
              "options",
              "recommended"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^q[0-9]+$"
              },
              "question": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "why": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500,
                "description": "What changes in the stories depending on the answer."
              },
              "options": {
                "type": "array",
                "minItems": 2,
                "maxItems": 4,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                }
              },
              "recommended": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300,
                "description": "One of the options, copied exactly."
              }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stories"
      ],
      "properties": {
        "stories": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "title",
              "as_a",
              "i_want",
              "so_that",
              "done_when",
              "out_of_scope",
              "sources"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
                "maxLength": 80
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "as_a": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "i_want": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "so_that": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "done_when": {
                "type": "array",
                "minItems": 1,
                "maxItems": 12,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 400
                },
                "description": "Observable acceptance criteria."
              },
              "out_of_scope": {
                "type": "array",
                "maxItems": 12,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                }
              },
              "sources": {
                "type": "array",
                "maxItems": 10,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
                  "maxLength": 80
                },
                "description": "Wiki pages the story rests on."
              }
            }
          }
        }
      }
    }
  ]
}
