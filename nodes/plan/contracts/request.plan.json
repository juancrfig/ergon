{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Plan request: a goal to turn into user stories",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "from",
    "goal"
  ],
  "properties": {
    "type": {
      "const": "plan"
    },
    "from": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 40
    },
    "goal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000,
      "description": "What the human wants built, in their words. Documents go through Intake first; the planner reads the wiki."
    }
  }
}
