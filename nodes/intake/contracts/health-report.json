{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Semantic health findings (model output for health-check)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "findings"
  ],
  "properties": {
    "findings": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "page",
          "kind",
          "text"
        ],
        "properties": {
          "page": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "maxLength": 80
          },
          "kind": {
            "enum": [
              "contradiction",
              "weak-claim"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "other_page": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
            "maxLength": 80,
            "description": "The other page, for a contradiction."
          }
        }
      }
    }
  }
}
