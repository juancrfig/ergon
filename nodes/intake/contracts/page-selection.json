{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pages the model needs to read (model output, large wikis only)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pages"
  ],
  "properties": {
    "pages": {
      "type": "array",
      "maxItems": 15,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
        "maxLength": 80
      }
    }
  }
}
