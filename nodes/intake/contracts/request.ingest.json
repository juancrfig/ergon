{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Intake request: ingest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "from",
    "source"
  ],
  "properties": {
    "type": {
      "const": "ingest"
    },
    "from": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 40,
      "description": "Node or agent that sent the request."
    },
    "source": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "url"
          ],
          "properties": {
            "url": {
              "type": "string",
              "pattern": "^https?://",
              "maxLength": 2000
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "file"
          ],
          "properties": {
            "file": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500,
              "pattern": "^(?!/)(?!.*\\.\\.)"
            }
          }
        }
      ],
      "description": "Where the source is. Pasted text goes in a project file first."
    },
    "note": {
      "type": "string",
      "maxLength": 2000,
      "description": "What the sender thinks matters in the source."
    },
    "reply_to": {
      "type": "string",
      "maxLength": 500,
      "pattern": "^(?!/)(?!.*\\.\\.)",
      "description": "Project-relative folder that receives <id>.result.json when the request finishes."
    }
  }
}
