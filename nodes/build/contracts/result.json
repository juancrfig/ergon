{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "The result of one task: a change, no change needed, or a stop",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["change"],
      "properties": {
        "change": {
          "type": "array",
          "minItems": 1,
          "description": "One entry per criterion the task covers: how the change makes it true.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["criterion", "how"],
            "properties": {
              "criterion": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*#[0-9]+$"},
              "how": {"type": "string", "minLength": 1, "maxLength": 1000}
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["no_change"],
      "properties": {
        "no_change": {
          "type": "array",
          "minItems": 1,
          "description": "One entry per criterion the task covers: where the code already makes it true (file and what).",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["criterion", "how"],
            "properties": {
              "criterion": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*#[0-9]+$"},
              "how": {"type": "string", "minLength": 1, "maxLength": 1000}
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["stop"],
      "properties": {
        "stop": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reason", "question"],
          "properties": {
            "reason": {"type": "string", "minLength": 1, "maxLength": 2000, "description": "The design decision the task leaves open, and what in the code shows it."},
            "question": {"type": "string", "minLength": 1, "maxLength": 500, "description": "The question the architect must answer."}
          }
        }
      }
    }
  ]
}
