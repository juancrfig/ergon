{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Build request: the tasks of one Split run to build",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "from", "split"],
  "properties": {
    "type": {"const": "build"},
    "from": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 40},
    "split": {"type": "string", "pattern": "^[0-9]{8}T[0-9]{6}Z-[a-z0-9-]+$", "description": "The id of a Split request that is done."}
  }
}
