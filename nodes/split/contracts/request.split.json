{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Split request: an approved plan to turn into tasks",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "from", "plan"],
  "properties": {
    "type": {"const": "split"},
    "from": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 40},
    "plan": {"type": "string", "pattern": "^[0-9]{8}T[0-9]{6}Z-[a-z0-9-]+$", "description": "The id of an approved plan."}
  }
}
